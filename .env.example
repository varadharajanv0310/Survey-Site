# ---------------------------------------------------------------------------
# Local development. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Postgres (docker-compose brings this up on 5433 to avoid clashing with a
# local Postgres install on the default port)
DATABASE_URL=postgres://rewards:rewards@localhost:5433/rewards

# Tests truncate everything they touch, so they get their own database and will
# refuse to run against one whose name does not end in `_test`.
#   docker exec surveysite-postgres-1 psql -U rewards -d postgres -c "CREATE DATABASE rewards_test;"
#   DATABASE_URL=postgres://rewards:rewards@localhost:5433/rewards_test npm run db:migrate
TEST_DATABASE_URL=postgres://rewards:rewards@localhost:5433/rewards_test

# Redis (BullMQ + rate limiting)
REDIS_URL=redis://localhost:6380

# API + web
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Secrets. Rotate these for anything that is not a laptop.
# ---------------------------------------------------------------------------

# Signs session cookies.
SESSION_SECRET=dev-only-change-me-session

# Signs the opaque user token we embed in offerwall / survey wall URLs and
# verify on the way back in. Without this, anyone can credit any account by
# calling a postback URL with someone else's user id.
USER_TOKEN_SECRET=dev-only-change-me-usertoken

# ---------------------------------------------------------------------------
# Network credentials.
#
# The database stores only the NAME of the env var holding a network's secret
# (networks.secret_ref), never the secret itself. That keeps live credentials
# out of DB backups, seed files and the admin UI.
#
# The two below belong to the local simulator, not a real network. Real ones
# get added here as the accounts land.
# ---------------------------------------------------------------------------

SIM_SURVEY_WALL_SECRET=sim-survey-secret
SIM_OFFER_WALL_SECRET=sim-offer-secret

# ---------------------------------------------------------------------------
# Third-party services. All unset until the accounts exist; every consumer
# falls back to a local stub when the value is absent.
# ---------------------------------------------------------------------------

# Email delivery (Resend). Unset => emails are written to the console.
RESEND_API_KEY=

# Fraud signals (IPQualityScore / MaxMind minFraud). Unset => those checks
# report 'unavailable' and the pipeline applies FRAUD_FAIL_MODE.
IPQS_API_KEY=
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Payout provider. Unset => MockPayoutProvider.
PAYOUT_PROVIDER=mock
TREMENDOUS_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
